# Environment variable contract — Jev MCP
#
# Copy to `.env` (git-ignored) and fill in real values. Never commit `.env` or paste
# real values into prompts, logs, or tool arguments (see .agent/SAFETY.md).

# Preferred TypeSafe API key — loaded from this project's gitignored `.env` on MCP start
JEV_TOKEN=<typesafe api key>
# TYPESAFE_API_KEY=<fallback if JEV_TOKEN unset>

# Pin a versioned model for calibration-sensitive work (default jev-1.14.0; set jev-1.13.0 to retain prior behavior)
JEV_MODEL=jev-1.14.0

# HTTP timeout for System One calls
JEV_TIMEOUT_SECONDS=30

# Optional: absolute path to another .env (used only for keys missing from process/.env)
# JEV_ENV_FILE=D:\path\to\.env
# Optional allowed local image directories (; on Windows, : elsewhere).
# Local paths are disabled when unset. Each request also requires allow_images=true.
# JEV_IMAGE_ROOTS=D:\path\to\prepared-images
# No environment opt-in for images/long context: use per-request booleans.
